spring.application.name=notificationService

# JDBC config
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/notification_service_directory}
spring.datasource.username=${DB_USERNAME:springstudent}
spring.datasource.password=${DB_PASSWORD:springstudent}

# Hibernate config
spring.jpa.hibernate.ddl-auto=update

# JWT config
# Provide a 256-bit (32-byte) Base64 encoded secret key
app.jwt.secret=YOUR_JWT_SECRET_KEY
app.jwt.expiration-ms=3600000

# Redis config
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.redis.host=${REDIS_HOST:localhost}
spring.redis.port=${REDIS_PORT:6379}

# Kafka config
spring.kafka.bootstrap-servers=${KAFKA_SERVERS:localhost:9092}
spring.kafka.listener.missing-topics-fatal=false
spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.springframework.kafka.support.serializer.JsonSerializer
spring.kafka.consumer.key-deserializer=org.apache.kafka.common.serialization.StringDeserializer
spring.kafka.consumer.value-deserializer=org.springframework.kafka.support.serializer.JsonDeserializer
spring.kafka.consumer.properties.spring.json.trusted.packages=com.projects.notificationService.dto
spring.kafka.consumer.properties.spring.json.use.type.headers=true

# Log config
logging.level.org.hibernate.orm.queries=trace

# Actuator Config
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=always
